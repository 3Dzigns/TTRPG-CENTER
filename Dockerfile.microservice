# MVP v2 Microservices Dockerfile
FROM python:3.12-slim as base

# Set build argument for service name
ARG SERVICE_NAME
ENV SERVICE_NAME=${SERVICE_NAME}

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY src_common/ ./src_common/
COPY services/ ./services/
COPY pyproject.toml ./

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash ttrpg

# Create required directories with proper permissions
RUN mkdir -p /app/env/dev/logs/audit /app/env/dev/data /app/env/dev/artifacts /app/env/dev/uploads /app/env/dev/cache && \
    chown -R ttrpg:ttrpg /app
USER ttrpg

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/healthz || exit 1

# Default command - will be overridden by docker-compose
CMD python -m uvicorn services.${SERVICE_NAME}.api:app --host 0.0.0.0 --port ${PORT:-8000}