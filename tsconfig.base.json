{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "allowJs": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@ttrpg-center/config/*": ["packages/config/*"],
      "@ttrpg-center/types": ["packages/types/src/index.ts"],
      "@ttrpg-center/types/*": ["packages/types/src/*"],
      "@ttrpg-center/api": ["packages/api/src/index.ts"],
      "@ttrpg-center/api/*": ["packages/api/src/*"],
      "@ttrpg-center/ui": ["packages/ui/src/index.ts"],
      "@ttrpg-center/ui/*": ["packages/ui/src/*"]
    }
  }
}
