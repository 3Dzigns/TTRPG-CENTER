# MVP v2 External Test Runner Dockerfile
FROM python:3.12-slim

# Install system dependencies including test tools
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    git \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
COPY requirements-test.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir -r requirements-test.txt

# Copy source code and tests
COPY src_common/ ./src_common/
COPY services/ ./services/
COPY tests/ ./tests/
COPY scripts/ ./scripts/
COPY pyproject.toml ./

# Create test runner service
COPY services/test_runner/ ./services/test_runner/

# Create non-root user
RUN useradd --create-home --shell /bin/bash ttrpg
RUN chown -R ttrpg:ttrpg /app
USER ttrpg

# Expose test runner port
EXPOSE ${TEST_RUNNER_PORT:-8195}

# Health check for test runner
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${TEST_RUNNER_PORT:-8195}/healthz || exit 1

# Default command - external test execution service
CMD python -m uvicorn services.test_runner.api:app --host 0.0.0.0 --port ${TEST_RUNNER_PORT:-8195}