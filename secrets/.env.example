# ============================================================
# Docker Swarm Secrets Template
# ============================================================
#
# This file serves as a template for creating Docker secrets.
# DO NOT store actual secret values in this file.
#
# To initialize secrets:
#   1. Copy this file: cp .env.example ../.env
#   2. Fill in actual values in ../.env
#   3. Run: ./create_secrets.sh --from-env-file ../.env
#   4. Securely delete or store ../.env outside version control
#
# ============================================================

# OpenAI API Configuration
# Used by: pass_d_hayhooks.py, gate_1_log_analyzer.py,
#          gate_1_db_remediation_executor.py, gate_1_pipeline_optimizer.py
# Format: sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_API_KEY=your_openai_api_key_here

# Neo4j Database Credentials
# Used by: Neo4j service, verify_neo4j.py, pass_e_neo4j_upsert.py
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_neo4j_password_here

# PostgreSQL Database Credentials
# Used by: PostgreSQL service, future authentication backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=ttrpg_auth
AUTH_DATABASE_URL=postgres://postgres:your_secure_postgres_password_here@postgres:5432/ttrpg_auth

# ============================================================
# Future Secrets (Uncomment when needed)
# ============================================================

# Cassandra Credentials (if authentication enabled)
# CASSANDRA_USER=cassandra
# CASSANDRA_PASSWORD=your_secure_cassandra_password_here

# MongoDB Credentials (if authentication enabled)
# MONGODB_USER=admin
# MONGODB_PASSWORD=your_secure_mongodb_password_here

# n8n Encryption Key (for credential storage)
# N8N_ENCRYPTION_KEY=your_secure_n8n_encryption_key_here

# Stargate API Credentials
# STARGATE_AUTH_TOKEN=your_stargate_auth_token_here

# ============================================================
# Security Notes
# ============================================================
#
# 1. NEVER commit .env files with actual secrets to version control
# 2. Use strong, randomly generated passwords (min 32 characters)
# 3. Rotate secrets regularly (quarterly recommended)
# 4. Store backup of secrets in secure password manager
# 5. Limit access to .env files with file permissions (chmod 600)
#
# Generate secure password:
#   openssl rand -base64 32
#
# Generate OpenAI-style key (for testing):
#   echo "sk-proj-$(openssl rand -base64 48 | tr -d '\n' | tr '+/' '-_')"
#
# ============================================================
